---
import { Image } from 'astro:assets';
import cityNight from '../assets/city-night.png';
import { contest, finalistTeams } from '../data/contest';
import { koreanDate } from '../lib/format';

const day = koreanDate(contest.convergenceDay.at);
const [first, ...rest] = contest.convergenceDay.theme.split(' to ');
---

<section class="cday on-night" id="convergence-day" aria-labelledby="cday-title">
  <Image
    class="cday__image"
    src={cityNight}
    alt=""
    format="webp"
    quality={68}
    widths={[768, 1280, 2048]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
  />
  <div class="cday__shade" aria-hidden="true"></div>

  <div class="wrap cday__inner">
    <p class="cday__eyebrow label" lang="en" data-reveal>
      {contest.convergenceDay.title} {contest.year}
    </p>
    <h2 class="cday__title" id="cday-title" lang="en" data-reveal style="--i:1">
      <span>{first}</span>{' '}
      <span class="cday__title-to">to {rest.join(' to ')}</span>
    </h2>

    <div class="cday__meta" data-reveal style="--i:2">
      <dl>
        <div>
          <dt class="label">일시</dt>
          <dd class="mono num">
            <span aria-hidden="true">{day.dotted} ({day.weekday})</span>
            <span class="sr-only">{day.year}년 {day.spoken} {day.weekday}요일</span>
          </dd>
        </div>
        <div>
          <dt class="label">장소</dt>
          <dd>{contest.venue}</dd>
        </div>
      </dl>
      <p class="cday__text">
        경진대회 상위 {finalistTeams}팀의 발표평가와 시상이 컨버전스 데이에서 열립니다. 학생 발표와 함께 외부 전문가, 산업계 연사와 교류하는 자리입니다.
      </p>
    </div>
  </div>
</section>

<style>
  .cday {
    position: relative;
    padding-block: clamp(6rem, 4rem + 10vw, 13rem);
    background: var(--night);
    color: var(--on-night);
    overflow: hidden;
    isolation: isolate;
  }

  .cday__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cday__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(8 12 22 / 0.92) 0%, rgb(8 12 22 / 0.76) 50%, rgb(8 12 22 / 0.5) 100%),
      linear-gradient(0deg, rgb(8 12 22 / 0.78) 0%, rgb(8 12 22 / 0) 46%);
  }

  .cday__eyebrow {
    color: var(--amber);
  }

  .cday__title {
    margin-top: 1.25rem;
    font-size: clamp(2.125rem, 0.4rem + 8.9vw, 8.5rem);
    font-weight: var(--weight-display);
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .cday__title span {
    display: block;
  }

  .cday__title-to {
    color: var(--amber);
  }

  .cday__meta {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1.5rem clamp(1.5rem, 4vw, 4rem);
    margin-top: var(--space-block);
    padding-top: 1.5rem;
    border-top: 1px solid var(--night-rule);
  }

  .cday__meta dl {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .cday__meta dt {
    color: var(--on-night-muted);
  }

  .cday__meta dd {
    margin-top: 0.25rem;
    font-size: var(--text-title);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .cday__text {
    max-width: 34rem;
    color: var(--on-night);
    font-size: var(--text-lede);
    line-height: 1.7;
    /* 사진의 밝은 창문 불빛 위에서도 읽히도록 글자 뒤를 어둡게 받친다. */
    text-shadow:
      0 0 0.75rem rgb(8 12 22 / 0.9),
      0 0 0.125rem rgb(8 12 22 / 0.9);
  }

  @media (max-width: 52rem) {
    .cday__meta {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
