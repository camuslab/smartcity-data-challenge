---
import { contest, credits, heroScenes } from '../data/contest';
import { koreanDate, withBase } from '../lib/format';

// 마지막 구역의 지도는 바뀌지 않고 첫 지역(가천대학교)만 보여 준다.
const scenes = heroScenes.slice(0, 1).map((scene) => ({
  src: withBase(`data/roads-${scene.id}.json`),
  label: scene.label,
  area: scene.area,
}));
const deadline = koreanDate(contest.deadline);
const { maker } = credits;
---

<div class="closing on-night">
  <canvas class="closing__map" data-road-network data-variant="closing" data-scenes={JSON.stringify(scenes)} aria-hidden="true"></canvas>
  <div class="closing__scrim" aria-hidden="true"></div>

  <section class="wrap closing__inner" aria-labelledby="closing-title">
    <p class="closing__dday mono num" data-dday aria-hidden="true">{deadline.monthDay}</p>
    <h2 class="closing__title" id="closing-title" data-reveal>
      <span class="closing__open" aria-hidden="true">{deadline.spoken} {deadline.weekday}요일</span>{' '}
      <span class="closing__open" aria-hidden="true">{deadline.time} 접수 마감</span>
      <span class="closing__open sr-only">{deadline.spoken} {deadline.weekday}요일 {deadline.spokenTime} 접수 마감</span>
      <span class="closing__closed">접수 종료</span>
    </h2>
    <p class="closing__clock mono num" data-clock aria-hidden="true">{deadline.dotted} {deadline.time}</p>
    <div class="closing__actions" data-reveal style="--i:1">
      <a class="btn btn--amber" href="#submit">
        제출 방법 보기
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost-night mono" href={`mailto:${contest.email}`}>{contest.email}</a>
    </div>
  </section>

  <footer class="wrap closing__foot">
    <dl>
      <div>
        <dt class="label">주최</dt>
        <dd>{contest.host}</dd>
      </div>
      <div>
        <dt class="label">문의</dt>
        <dd><a class="mono" href={`mailto:${contest.email}`}>{contest.email}</a></dd>
      </div>
      <div>
        <dt class="label">지도 데이터</dt>
        <dd>
          <a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer" target="_blank">
            <span lang="en">© OpenStreetMap contributors</span>
            <span class="sr-only">(새 탭에서 열림)</span>
          </a>
        </dd>
      </div>
    </dl>
    <div class="closing__small">
      <p class="closing__copy mono">© {contest.year} {contest.host}</p>
      <p class="closing__maker">
        제작 {maker.affiliation} {maker.name} ({maker.year}) · <a class="mono" href={`mailto:${maker.email}`}>{maker.email}</a>
      </p>
    </div>
  </footer>
</div>

<style>
  .closing {
    position: relative;
    background: var(--night);
    color: var(--on-night);
    overflow: hidden;
    isolation: isolate;
  }

  .closing__map {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .closing__map:global(.is-ready) {
    opacity: 0.9;
  }

  .closing__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(8 12 22 / 0.94) 0%, rgb(8 12 22 / 0.66) 48%, rgb(8 12 22 / 0.12) 100%),
      linear-gradient(0deg, rgb(8 12 22 / 0.96) 0%, rgb(8 12 22 / 0) 46%);
  }

  .closing__inner {
    padding-block: clamp(6rem, 4rem + 10vw, 12rem) clamp(4rem, 3rem + 5vw, 7rem);
  }

  .closing__dday {
    color: var(--amber);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    font-weight: 700;
  }

  .closing__title {
    margin-top: 0.75rem;
    font-size: var(--text-display);
    font-weight: var(--weight-display);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
  }

  .closing__title span:not(.sr-only) {
    display: block;
  }

  /* 마감이 지나면 clock.ts가 html에 is-closed를 붙인다. */
  .closing__title span.closing__closed,
  :global(.is-closed) .closing__title .closing__open {
    display: none;
  }

  :global(.is-closed) .closing__title .closing__closed {
    display: block;
  }

  .closing__clock {
    margin-top: 1.25rem;
    color: var(--on-night-muted);
    font-size: 1rem;
  }

  .closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem);
  }

  .closing__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem 2.5rem;
    border-top: 1px solid var(--night-rule);
  }

  .closing__foot dl {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem clamp(2rem, 5vw, 4.5rem);
    margin: 0;
  }

  .closing__foot dt {
    color: var(--on-night-muted);
  }

  .closing__foot dd {
    margin-top: 0.375rem;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .closing__foot a {
    text-decoration-color: rgb(243 241 234 / 0.4);
  }

  .closing__foot a:hover {
    color: var(--amber);
  }

  .closing__small {
    display: grid;
    gap: 0.375rem;
    justify-items: end;
    text-align: right;
  }

  .closing__copy,
  .closing__maker {
    color: var(--on-night-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (max-width: 52rem) {
    .closing__small {
      justify-items: start;
      text-align: left;
    }
  }
</style>
