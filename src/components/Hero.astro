---
import { contest, heroScenes } from '../data/contest';
import { koreanDate, withBase } from '../lib/format';

// 지도는 첫 지역(가천대학교)에서 시작해 나머지 지역으로 차례로 바뀐다.
const scenes = heroScenes.map((scene) => ({
  src: withBase(`data/roads-${scene.id}.json`),
  label: scene.label,
  area: scene.area,
}));
const deadline = koreanDate(contest.deadline);
const deadlineMs = new Date(contest.deadline).getTime();
const spokenDeadline = `${deadline.year}년 ${deadline.spoken} ${deadline.weekday}요일 ${deadline.spokenTime}`;
const hostParts = contest.hostEn.split(' · ');
const lat = contest.campus.lat.toFixed(4);
const lon = contest.campus.lon.toFixed(4);
---

<section class="hero on-night" id="top" data-hero aria-labelledby="hero-title">
  <canvas class="hero__map" data-road-network data-variant="hero" data-scenes={JSON.stringify(scenes)} aria-hidden="true"></canvas>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <p class="hero__eyebrow label" lang="en">
      {hostParts[0]}<span class="hero__eyebrow-extra"> · {hostParts.slice(1).join(' · ')}</span> · {contest.year}
    </p>

    <h1 class="hero__title" id="hero-title">
      {
        contest.nameLines.map((line, i) => (
          <>
            <span class="hero__line" style={`--i:${i}`}>
              <span class:list={{ 'hero__line-text': true, 'is-accent': i === 1 }}>{line}</span>
            </span>{' '}
          </>
        ))
      }
    </h1>

    <p class="hero__lede">도시의 문제를 데이터로 풀어 보세요.</p>

    <div class="hero__actions">
      <a class="btn btn--amber" href="#submit">
        제출 방법 보기
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost-night" href="#schedule">일정 확인</a>
    </div>
  </div>

  <div class="wrap hero__foot">
    <p class="hero__countdown" data-deadline={deadlineMs}>
      <span class="label" aria-hidden="true">제출 마감</span>
      <span class="hero__dday mono num" data-dday aria-hidden="true">{deadline.monthDay}</span>
      <span class="hero__clock mono num" data-clock aria-hidden="true">({deadline.weekday}) {deadline.time}</span>
      <span class="sr-only" data-deadline-text data-closed-text={`접수가 마감되었습니다. 마감 일시: ${spokenDeadline}.`}>
        제출 마감은 {spokenDeadline}입니다.
      </span>
    </p>
    <p class="hero__coords mono" aria-hidden="true">
      <span data-road-latlon>{lat}°N {lon}°E</span><span class="hero__coords-area" data-road-area> · {contest.campus.area}</span>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: var(--header-h);
    padding-bottom: clamp(5.5rem, 4rem + 5vw, 8.5rem);
    background: var(--night);
    color: var(--on-night);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__map {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .hero__map:global(.is-ready) {
    opacity: 1;
  }

  /* 다른 지역으로 넘어갈 때 지도와 좌표를 잠깐 껐다 켠다. */
  .hero:global(.is-switching) .hero__map,
  .hero:global(.is-switching) .hero__coords {
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .hero__coords {
    transition: opacity 0.4s var(--ease-out);
  }

  /* 왼쪽 글자 뒤와 아래쪽을 어둡게 눌러 읽기 좋게 한다. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(8 12 22 / 0.9) 0%, rgb(8 12 22 / 0.62) 34%, rgb(8 12 22 / 0) 68%),
      linear-gradient(0deg, rgb(8 12 22 / 0.86) 0%, rgb(8 12 22 / 0) 30%);
    pointer-events: none;
  }

  .hero__inner {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(2rem, 6svh, 4.5rem) clamp(1.5rem, 4svh, 3rem);
  }

  .hero__eyebrow {
    color: var(--on-night);
    animation: rise var(--dur-slow) var(--ease-out) both;
  }

  .hero__title {
    margin-top: clamp(1rem, 2.4svh, 1.75rem);
    font-size: min(var(--text-hero), 15.8svh);
    font-weight: var(--weight-display);
    line-height: 0.98;
    letter-spacing: var(--tracking-display);
  }

  .hero__line {
    display: block;
    overflow: hidden;
    /* 받침과 글자 윗부분이 잘리지 않도록 여유를 둔다. */
    padding-block: 0.06em;
    margin-block: -0.06em;
  }

  .hero__line-text {
    display: block;
    animation: line-up 1.1s var(--ease-out) both;
    animation-delay: calc(120ms + var(--i) * 110ms);
  }

  .hero__line-text.is-accent {
    color: var(--amber);
  }

  .hero__lede {
    max-width: 34rem;
    margin-top: clamp(1.25rem, 3svh, 2.25rem);
    color: rgb(243 241 234 / 0.86);
    font-size: var(--text-lede);
    line-height: 1.65;
    animation: rise var(--dur-slow) var(--ease-out) 520ms both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3.6svh, 2.5rem);
    animation: rise var(--dur-slow) var(--ease-out) 640ms both;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--night-rule);
    animation: rise var(--dur-slow) var(--ease-out) 780ms both;
  }

  .hero__countdown {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .hero__countdown .label {
    color: var(--on-night);
  }

  .hero__countdown .label {
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.125rem);
  }

  .hero__dday {
    color: var(--amber);
    font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__clock {
    font-size: clamp(1.0625rem, 0.95rem + 0.6vw, 1.375rem);
  }

  /* 지금 보이는 지도가 어디인지 알려 주는 유일한 표시라 앰버색으로 눈에 띄게 한다. */
  .hero__coords {
    color: var(--amber);
    font-size: 0.875rem;
    font-weight: 500;
  }

  @keyframes line-up {
    from {
      transform: translate3d(0, 105%, 0);
    }
    to {
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 1rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 47.5rem) {
    .hero__scrim {
      background:
        linear-gradient(0deg, rgb(8 12 22 / 0.94) 0%, rgb(8 12 22 / 0.78) 46%, rgb(8 12 22 / 0.1) 78%),
        linear-gradient(180deg, rgb(8 12 22 / 0.7) 0%, rgb(8 12 22 / 0) 18%);
    }

    .hero__inner {
      justify-content: flex-end;
    }

    .hero__title {
      font-size: min(17.2vw, 13svh);
    }

    .hero__eyebrow-extra {
      display: none;
    }
  }
</style>
