---
import Section from './Section.astro';
import { prizes, totalPrize, totalWinners } from '../data/contest';
import { manLabel, toMan, wonLabel } from '../lib/format';

const topAmount = Math.max(...prizes.map((prize) => prize.amount));
const rows = prizes.map((prize) => ({
  ...prize,
  share: prize.amount / topAmount,
  subtotal: prize.amount * prize.teams,
}));
---

<Section id="prizes" index="05" label="Prizes" title={`총상금\n${manLabel(totalPrize)}.`} tone="amber">
  <p class="prizes__summary" data-reveal style="--i:1">
    {totalWinners}팀에게 <span class="mono num">{wonLabel(totalPrize)}</span>을 드립니다. 금액은 팀당 기준이고, 개인으로 참가해도 같은 상금을 받습니다.
  </p>

  <ol class="prizes" role="list">
    {
      rows.map((row, i) => (
        <li class="prizes__row" data-reveal style={`--i:${i}; --share:${row.share.toFixed(3)}`}>
          <div class="prizes__tier">
            <h3>{row.tier}</h3>
            <p class="mono num">{row.teams}팀</p>
          </div>
          <div class="prizes__amount">
            <p class="prizes__figure num">
              {row.teams > 1 && <small class="prizes__each">각</small>}<span data-count-to={toMan(row.amount)}>{toMan(row.amount)}</span><small>만원</small>
            </p>
            <span class="prizes__bar" aria-hidden="true" />
          </div>
          <p class="prizes__note">
            <span>{row.note}</span>
            {row.teams > 1 && <span class="mono num">합계 {manLabel(row.subtotal)}</span>}
          </p>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .prizes__summary {
    max-width: 39rem;
    margin-top: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-size: var(--text-lede);
    line-height: 1.7;
  }

  .prizes__summary .mono {
    font-weight: 700;
  }

  .prizes {
    margin-top: var(--space-block);
    border-top: 2px solid var(--ink);
  }

  .prizes__row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
    align-items: end;
    gap: 0.75rem clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-block: clamp(1.5rem, 1rem + 1.8vw, 2.5rem);
    border-bottom: 1px solid rgb(16 21 31 / 0.3);
  }

  .prizes__tier h3 {
    font-size: var(--text-title);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .prizes__tier p {
    margin-top: 0.375rem;
    font-size: var(--text-small);
    font-weight: 500;
  }

  .prizes__figure {
    font-size: clamp(2.75rem, 1.6rem + 5vw, 6rem);
    font-weight: var(--weight-display);
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .prizes__figure small {
    margin-left: 0.2em;
    font-size: 0.3em;
    letter-spacing: -0.02em;
  }

  .prizes__figure .prizes__each {
    margin: 0 0.35em 0 0;
  }

  /* 막대 길이는 상금 크기에 비례한다. */
  .prizes__bar {
    display: block;
    width: calc(var(--share) * 100%);
    height: 0.625rem;
    margin-top: 1rem;
    background: var(--ink);
    transform-origin: left;
  }

  :global(.js) .prizes__row .prizes__bar {
    transform: scaleX(0);
    transition: transform 1.3s var(--ease-out) calc(200ms + var(--i) * 90ms);
  }

  :global(.js) .prizes__row:global(.is-in) .prizes__bar {
    transform: none;
  }

  .prizes__note {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: var(--text-small);
    font-weight: 500;
    line-height: 1.5;
  }

  @media (max-width: 52rem) {
    .prizes__row {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .prizes__row .prizes__bar {
      transform: none;
    }
  }

  @media (forced-colors: active) {
    .prizes__bar {
      background: CanvasText;
      forced-color-adjust: none;
    }
  }
</style>
