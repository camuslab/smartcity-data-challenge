---
import Section from './Section.astro';
import MailDraft from './MailDraft.astro';
import { contest } from '../data/contest';
import { koreanDate } from '../lib/format';

const deadline = koreanDate(contest.deadline);

const steps = [
  {
    title: '팀 결성',
    body: `${contest.eligibility}이면 참가할 수 있습니다. 혼자 참가해도 되고, 팀이라면 최대 ${contest.maxTeamSize}명까지입니다.`,
  },
  {
    title: '결과물 제작',
    body: `분석 과정과 결과를 PPT ${contest.maxSlides}장 이내로 정리합니다. 양식은 자유이고 ${contest.maxSlides}장을 다 채울 필요는 없습니다. 웹페이지나 동영상을 함께 내도 됩니다.`,
  },
  {
    title: '이메일 제출',
    body: `${deadline.spoken} ${deadline.weekday}요일 ${deadline.time}까지 보냅니다. 메일 본문에 팀명, 참여자 학번과 이름, 발표 주제를 반드시 적어 주세요.`,
  },
];
---

<Section
  id="entry"
  index="02"
  label="Entry"
  title="개인·팀별 제출"
  lede={`개인 또는 팀(최대 ${contest.maxTeamSize}명)으로 참가하고, 결과물은 마감 전까지 이메일로 제출합니다.`}
>
  <ol class="steps" role="list">
    {
      steps.map((step, i) => (
        <li class="steps__item" data-reveal style={`--i:${i}`}>
          <p class="steps__index mono num" lang="en" aria-hidden="true">STEP {String(i + 1).padStart(2, '0')}</p>
          <h3 class="steps__title">{step.title}</h3>
          <p class="steps__body">{step.body}</p>
        </li>
      ))
    }
  </ol>

  <MailDraft />
</Section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: var(--space-block);
    border-top: 2px solid var(--ink);
  }

  .steps__item {
    padding: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem) clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem) 0;
    border-left: 1px solid var(--rule);
  }

  .steps__item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .steps__index {
    color: var(--amber-deep);
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
  }

  .steps__title {
    margin-top: 0.875rem;
    font-size: var(--text-title);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .steps__body {
    margin-top: 0.75rem;
    color: var(--ink-muted);
  }

  @media (max-width: 52rem) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps__item {
      padding: 1.5rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
